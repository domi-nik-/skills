# ── Database (Supabase Postgres — use the POOLER host) ──────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=            # browser-safe
SUPABASE_SERVICE_KEY=         # server-only — bypasses RLS, never expose

# ── Auth (BetterAuth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=           # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000

# ── App ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── Optional ────────────────────────────────────────────────────────────────
# NITRO_PRESET=node-server
